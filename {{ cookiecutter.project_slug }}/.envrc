# Loads the flake's dev shell on `cd` (run `direnv allow` once).
# The shell is built from these files too, so reload when they change.
watch_file package.nix deps.json
use flake

# First entry: configure the debug preset so compile_commands.json exists for clangd.
# `make configure` does nothing once the build directory exists.
make --no-print-directory configure >/dev/null || log_error "make configure failed"
